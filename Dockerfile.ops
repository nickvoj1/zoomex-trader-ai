FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends unzip ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ENV NODE_ENV=production

CMD ["sh", "-lc", "npm run ops:daemon -- --user-id ${BOT_USER_ID} --symbol ${OPS_SYMBOL:-BTCUSDT}"]
